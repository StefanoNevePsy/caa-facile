{
  "name": "caa-facile",
  "private": true,
  "version": "1.0.0",
  "description": "CAA Facile - strumenti di Comunicazione Aumentativa Alternativa (griglie, agende visive, token economy, storie sociali, PECS, timer)",
  "author": "StefanoNevePsy",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build:mac": "npm run build && electron-builder --mac --arm64",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.263.1",
    "mobile-drag-drop": "^3.0.0-rc.0",
    "onnxruntime-web": "^1.22.0-dev.20250409-89f8206ba4",
    "peerjs": "^1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^0.20.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.caafacile.app",
    "productName": "CAA Facile",
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "icon": "build/icon.icns",
      "hardenedRuntime": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": false
  }
}
